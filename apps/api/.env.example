# Server
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me-secret-token
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Providers (mock | http)
DATAJUD_PROVIDER=mock
DATAJUD_API_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=

DJEN_PROVIDER=mock
DJEN_API_URL=https://djen.example.com/api
DJEN_API_KEY=

PAYMENTS_PROVIDER=mock
PAYMENTS_API_URL=https://payments.example.com/api
PAYMENTS_API_KEY=

CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CREDENTIALS=

# Database (Supabase/Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/legalbot

# Redis
REDIS_URL=redis://localhost:6379

# Feature Flags
FEATURE_AGENT_REWRITE=false

# Logging
LOG_LEVEL=info
